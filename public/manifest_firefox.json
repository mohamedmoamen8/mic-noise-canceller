{
  "manifest_version": 2,
  "name": "Mic Noise Canceller",
  "version": "2.1.0",
  "description": "Real-time client-side background noise cancellation for your microphone, powered by RNNoise (WASM/ML) with a JS fallback, and a mic calibration step.",
  "permissions": ["storage", "tabs"],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Mic Noise Canceller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "page": "background-firefox.html",
    "persistent": true
  },
  "options_page": "options.html",
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0"
    }
  }
}
